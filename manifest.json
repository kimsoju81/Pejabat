{
  "id": "./index.html",
  "name": "Pejabat",
  "short_name": "Pejabat",
  "description": "Ruang kerja digital produktiviti Malaysia: Surat, Lembar, Bentang, Lukis, Layar, Laci dan Kalender dengan sokongan luar talian penuh.",
  "start_url": "./index.html",
  "scope": "./",
  "scope_extensions": [
    {
      "origin": "https://pejabat.org"
    },
    {
      "origin": "https://www.pejabat.org"
    },
    {
      "origin": "https://app.pejabat.org"
    }
  ],
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "url": "./index.html",
      "icons": [
        {
          "src": "./icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    "new_tab_button": {
      "url": "./index.html?module=surat"
    }
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "note_taking": {
    "new_note_url": "./index.html?module=surat&action=new-note"
  },
  "orientation": "any",
  "lang": "ms",
  "dir": "ltr",
  "background_color": "#efece1",
  "theme_color": "#0f1c30",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "categories": [
    "productivity",
    "utilities",
    "business",
    "education"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://pejabat.org/manifest.json",
      "id": "org.pejabat.pwa"
    }
  ],
  "icons": [
    {
      "src": "./icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/pejabat-desktop-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Paparan Utama Ruang Kerja Pejabat"
    },
    {
      "src": "./screenshots/pejabat-desktop-editor.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Penyunting Dokumen Rasmi Surat"
    },
    {
      "src": "./screenshots/pejabat-mobile-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Antara Muka Mudah Alih Pejabat"
    }
  ],
  "shortcuts": [
    {
      "name": "Surat",
      "short_name": "Surat",
      "description": "Cipta atau sunting dokumen Surat",
      "url": "./index.html?module=surat",
      "icons": [
        {
          "src": "./icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Lembar",
      "short_name": "Lembar",
      "description": "Buka jadual data dan formula Lembar",
      "url": "./index.html?module=lembar",
      "icons": [
        {
          "src": "./icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Layar",
      "short_name": "Layar",
      "description": "Studio suntingan video Layar",
      "url": "./index.html?module=layar",
      "icons": [
        {
          "src": "./icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Kalender",
      "short_name": "Kalender",
      "description": "Semak acara dan peringatan Kalender",
      "url": "./index.html?module=kalender",
      "icons": [
        {
          "src": "./icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html?module=surat",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/msword": [
          ".doc"
        ],
        "application/rtf": [
          ".rtf"
        ],
        "text/plain": [
          ".txt"
        ],
        "application/pdf": [
          ".pdf"
        ]
      }
    },
    {
      "action": "./index.html?module=lembar",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/vnd.oasis.opendocument.spreadsheet": [
          ".ods"
        ]
      }
    },
    {
      "action": "./index.html?module=bentang",
      "accept": {
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ],
        "application/vnd.ms-powerpoint": [
          ".ppt"
        ],
        "application/vnd.oasis.opendocument.presentation": [
          ".odp"
        ]
      }
    },
    {
      "action": "./index.html?module=lukis",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/svg+xml": [
          ".svg"
        ]
      }
    },
    {
      "action": "./index.html?module=layar",
      "accept": {
        "video/mp4": [
          ".mp4"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/quicktime": [
          ".mov"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+pejabat",
      "url": "./index.html?protocol=%s"
    },
    {
      "protocol": "mailto",
      "url": "./index.html?module=surat&mailto=%s"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*",
            "application/pdf",
            "text/plain",
            ".docx",
            ".xlsx",
            ".pptx",
            ".csv"
          ]
        }
      ]
    }
  },
  "widgets": [
    {
      "name": "Pejabat Pantas",
      "short_name": "Pejabat",
      "description": "Akses pantas ke ruang kerja Surat, Lembar, Bentang, Lukis, Layar dan Kalender Pejabat.",
      "tag": "pejabat-quick-widget",
      "template": "pejabat-quick-card",
      "ms_ac_template": "./widgets/pejabat-widget-template.json",
      "data": "./widgets/pejabat-widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "./screenshots/pejabat-widget-preview.png",
          "sizes": "600x400",
          "type": "image/png",
          "label": "Pratonton Widget Pejabat Pantas"
        }
      ],
      "icons": [
        {
          "src": "./icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ]
}
